{
  "name": "deepseek-harness-desktop",
  "version": "0.1.0",
  "description": "Windows desktop client for DeepSeek Harness",
  "main": "src/main.js",
  "type": "commonjs",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron .",
    "test:project-git": "node --test tests/project-git-service.test.cjs",
    "prepare-backend": "node scripts/prepare-backend.cjs",
    "stage": "node scripts/stage-app.cjs",
    "dist": "npm run prepare-backend && npm run stage && electron-builder --projectDir .build-app --dir --x64 && node scripts/inject-runtime.cjs && electron-builder --prepackaged release/win-unpacked --win nsis --x64",
    "dist:portable": "npm run prepare-backend && npm run stage && electron-builder --projectDir .build-app --dir --x64 && node scripts/inject-runtime.cjs && electron-builder --prepackaged release/win-unpacked --win portable --x64",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "simple-git": "3.36.0"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "26.15.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@deepseek-ai/dsh-subprocess-local",
      "@google/genai",
      "electron-winstaller",
      "koffi",
      "node-pty",
      "protobufjs"
    ]
  },
  "build": {
    "appId": "ai.deepseek.harness.desktop",
    "productName": "DeepSeek Harness Desktop",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend-dist",
        "to": "backend"
      }
    ],
    "extraMetadata": {
      "dependencies": {},
      "devDependencies": {}
    },
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "DeepSeek-Harness-Desktop-${version}-win-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
